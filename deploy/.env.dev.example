# DEV/STAGING — copier en « .env.dev » sur le VPS et remplir. NE JAMAIS committer le vrai fichier.
STACK=laca-dev
SPRING_PROFILE=dev

# Images GHCR
GHCR_OWNER=mon-user-github
BACKEND_TAG=dev
FRONTEND_TAG=dev

# URLs publiques de cet environnement
FRONT_URL=https://dev.cathclau-edu.com
API_URL=https://api-dev.cathclau-edu.com

# PostgreSQL (base dev, séparée de la prod)
POSTGRES_DB=cathclau_dev
POSTGRES_USER=cathclau_dev
POSTGRES_PASSWORD=CHANGER_mot_de_passe
# Port local du VPS pour la base (accès pgAdmin via tunnel SSH). Dev = 5433 (différent de la prod).
DB_HOST_PORT=5433

# Secrets application (dev)
JWT_SECRET=dev-secret-min-32-caracteres-aleatoires-______
WEBHOOK_SECRET=dev-webhook-secret
APP_QR_SECRET=dev-qr-secret

# SUPER_ADMIN dev (en plus du seed de test super@admin.gn / Test@1234)
SUPER_ADMIN_EMAIL=admin@dev.cathclau-edu.com
SUPER_ADMIN_PASSWORD=CHANGER

# Email (Mailtrap/sandbox conseillé en dev)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=CathClau Edu (Dev) <no-reply@cathclau-edu.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Djomy SANDBOX (tests de paiement)
DJOMY_CLIENT_ID=CLIENT_ID_SANDBOX
DJOMY_CLIENT_SECRET=CLIENT_SECRET_SANDBOX
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
DJOMY_WEBHOOK_SECRET=SECRET_WEBHOOK_SANDBOX
