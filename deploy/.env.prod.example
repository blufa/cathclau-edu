# PROD — copier en « .env.prod » sur le VPS et remplir. NE JAMAIS committer le vrai fichier.
STACK=laca-prod
SPRING_PROFILE=prod

# Images GHCR (propriétaire GitHub en minuscules)
GHCR_OWNER=mon-user-github
BACKEND_TAG=prod
FRONTEND_TAG=prod

# URLs publiques de cet environnement
FRONT_URL=https://cathclau-edu.com
API_URL=https://api.cathclau-edu.com

# PostgreSQL (prod)
POSTGRES_DB=cathclau
POSTGRES_USER=cathclau
POSTGRES_PASSWORD=CHANGER_mot_de_passe_fort
# Port local du VPS pour la base (accès pgAdmin via tunnel SSH). Prod = 5432.
DB_HOST_PORT=5432

# Secrets application
JWT_SECRET=CHANGER_min_32_caracteres_aleatoires_______________
WEBHOOK_SECRET=CHANGER_secret_webhooks
APP_QR_SECRET=CHANGER_secret_signature_qr

# SUPER_ADMIN créé au 1er démarrage (aucun seed de test en prod)
SUPER_ADMIN_EMAIL=admin@cathclau-edu.com
SUPER_ADMIN_PASSWORD=CHANGER_mot_de_passe_admin

# Email SMTP réel (ex. Brevo/Sendinblue, Mailgun, SendGrid, ou le SMTP de votre hébergeur)
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=postmaster@cathclau-edu.com
MAIL_PASSWORD=CHANGER
# Expéditeur affiché — DOIT être un domaine/adresse autorisé par le fournisseur SMTP.
MAIL_FROM=CathClau Edu <no-reply@cathclau-edu.com>

# Cloudinary (médias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Djomy PRODUCTION (paiement des frais scolaires + abonnements)
DJOMY_CLIENT_ID=CLIENT_ID_PROD
DJOMY_CLIENT_SECRET=CLIENT_SECRET_PROD
DJOMY_BASE_URL=https://api.djomy.africa
DJOMY_WEBHOOK_SECRET=SECRET_WEBHOOK_PROD
