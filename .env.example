
# Modèle d'environnement — copier en `.env` (non commité) et renseigner les vraies valeurs.

# Djomy (agrégateur de paiement) — sandbox par défaut.
DJOMY_CLIENT_ID=djomy-client-1781589348587-df3f
DJOMY_CLIENT_SECRET=s3cr3t-Wgn5EpDooOoqo73pD3otV-JRWNhux5wa
DJOMY_BASE_URL=https://sandbox-api.djomy.africa
DJOMY_CURRENCY=GNF
# URL de retour frontend après le portail Djomy (page "vérification en cours").
DJOMY_RETURN_URL=http://localhost:3000/paiement/retour
# URL de retour si le payeur abandonne le portail (sinon DJOMY_RETURN_URL est réutilisée).
DJOMY_CANCEL_URL=http://localhost:3000/paiement/annule
# Méthodes affichées sur le portail Djomy (vide = toutes). OM,MOMO,CARD,SOUTRA_MONEY,PAYCARD.
DJOMY_ALLOWED_METHODS=OM,MOMO,CARD,SOUTRA_MONEY,PAYCARD
# URL du webhook à enregistrer dans l'espace développeur Djomy (HTTPS obligatoire ; ngrok en local).
DJOMY_WEBHOOK_URL=https://accounts-sustainability-trustee-hierarchy.trycloudflare.com/api/v1/webhooks/paiement/djomy

# SMS Orange (Orange Developer). Mettre ORANGE_SMS_ENABLED=true et renseigner les clés pour envoyer
# de vrais SMS ; sinon les SMS sont seulement journalisés. SENDER_ADDRESS = numéro/expéditeur autorisé.
ORANGE_SMS_ENABLED=false
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_BASE_URL=https://api.orange.com
ORANGE_SMS_SENDER_ADDRESS=
# Sender ID alphanumérique optionnel (ex. CathClau), s'il est approuvé par Orange.
ORANGE_SMS_SENDER_NAME=
ORANGE_SMS_DEFAULT_DIALING=224

# Cloudinary (stockage des images & documents : photos élèves, logos, justificatifs, PDF).
# Renseigne ces 3 valeurs depuis ton dashboard Cloudinary (Account Details).
CLOUDINARY_CLOUD_NAME=djxw7qsii
CLOUDINARY_API_KEY=949638963587779
CLOUDINARY_API_SECRET=qwqzzjyGCIUZ1A5MwmXMbiV90vk
